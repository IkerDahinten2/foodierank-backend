{
  "openapi": "3.0.0",
  "info": {
    "title": "FoodieRank API",
    "version": "1.0.0",
    "description": "API REST modular para el registro, calificación y ranking de restaurantes con autenticación JWT y transacciones nativas en MongoDB."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Servidor de Desarrollo Local (SemVer v1)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Ingresa el token JWT recibido en /auth/login con el prefijo Bearer"
      }
    },
    "responses": {
      "NotFound": { "description": "El recurso solicitado no existe" },
      "Forbidden": { "description": "No tienes permisos para realizar esta acción" },
      "Unauthorized": { "description": "No has iniciado sesión o el token no es válido" },
      "ValidationError": { "description": "Los datos enviados no pasaron las validaciones" }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Registrar un nuevo usuario",
        "tags": ["Autenticación"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "email", "password"],
                "properties": {
                  "nombre": { "type": "string", "example": "Daniel Borja" },
                  "email": { "type": "string", "example": "daniel@foodierank.com" },
                  "password": { "type": "string", "example": "Password123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario registrado exitosamente" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "description": "El correo ya se encuentra registrado" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Iniciar sesión y obtener token JWT",
        "tags": ["Autenticación"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "daniel@foodierank.com" },
                  "password": { "type": "string", "example": "Password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Autenticación exitosa y retorno del token Bearer" },
          "401": { "description": "Credenciales inválidas" }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "summary": "Obtener el perfil del usuario autenticado (prueba de token)",
        "tags": ["Autenticación"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Datos del usuario autenticado" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Listar todas las categorías",
        "tags": ["Categorías"],
        "responses": {
          "200": { "description": "Lista de categorías obtenida" }
        }
      },
      "post": {
        "summary": "Crear categoría (Solo Admin)",
        "tags": ["Categorías"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre"],
                "properties": {
                  "nombre": { "type": "string", "example": "Gourmet" },
                  "descripcion": { "type": "string", "example": "Platos de autor y alta cocina" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Categoría creada con éxito" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "summary": "Obtener una categoría por ID",
        "tags": ["Categorías"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Categoría encontrada" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Actualizar categoría (Solo Admin)",
        "tags": ["Categorías"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre"],
                "properties": {
                  "nombre": { "type": "string" },
                  "descripcion": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Categoría actualizada exitosamente" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Eliminar categoría (Solo Admin)",
        "tags": ["Categorías"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Categoría eliminada exitosamente" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/restaurants": {
      "get": {
        "summary": "Listar restaurantes aprobados con filtro opcional por categoría",
        "tags": ["Restaurantes"],
        "parameters": [
          { "name": "categoriaId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Listado de restaurantes disponibles" }
        }
      },
      "post": {
        "summary": "Registrar un restaurante (queda pendiente si lo crea un usuario)",
        "tags": ["Restaurantes"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "descripcion", "categoriaId", "ubicacion"],
                "properties": {
                  "nombre": { "type": "string", "example": "La Trattoria" },
                  "descripcion": { "type": "string", "example": "Comida tradicional italiana" },
                  "categoriaId": { "type": "string", "example": "64f1a2b3c4d5e6f7a8b9c0d1" },
                  "ubicacion": { "type": "string", "example": "Zona 10, Ciudad de Guatemala" },
                  "imagenUrl": { "type": "string", "example": "https://ejemplo.com/foto.jpg" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Restaurante creado" },
          "400": { "description": "Categoría inválida" },
          "409": { "description": "Nombre duplicado" }
        }
      }
    },
    "/restaurants/with-dish": {
      "post": {
        "summary": "Registrar un restaurante junto a su primer plato en una sola transacción",
        "tags": ["Restaurantes"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "descripcion", "categoriaId", "ubicacion", "horario", "imagenUrl", "platoNombre", "platoDescripcion", "platoPrecio"],
                "properties": {
                  "nombre": { "type": "string" },
                  "descripcion": { "type": "string" },
                  "categoriaId": { "type": "string" },
                  "ubicacion": { "type": "string" },
                  "horario": { "type": "string", "example": "Lunes a domingo, 8:00 - 20:00" },
                  "imagenUrl": { "type": "string" },
                  "platoNombre": { "type": "string" },
                  "platoDescripcion": { "type": "string" },
                  "platoPrecio": { "type": "number", "example": 65.5 },
                  "platoImagenUrl": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Restaurante y plato creados en una sola transacción ACID" },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/restaurants/mine": {
      "get": {
        "summary": "Listar los restaurantes creados por el usuario autenticado (cualquier estado)",
        "tags": ["Restaurantes"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Restaurantes propios" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/restaurants/notifications/mine": {
      "get": {
        "summary": "Obtener y marcar como vistas las notificaciones de moderación del usuario",
        "tags": ["Restaurantes"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Notificaciones pendientes de aviso" }
        }
      }
    },
    "/restaurants/admin/all": {
      "get": {
        "summary": "Listar TODOS los restaurantes sin filtrar por estado (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Listado completo para panel admin" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/restaurants/admin/dishes/pending": {
      "get": {
        "summary": "Listar platos pendientes de moderación (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Platos pendientes" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/restaurants/{id}": {
      "get": {
        "summary": "Obtener el detalle de un restaurante junto a sus platos aprobados",
        "tags": ["Restaurantes"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Detalle del restaurante" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Editar restaurante (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Restaurante actualizado exitosamente" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Eliminar restaurante y todos sus platos/reseñas vinculados (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Restaurante y datos vinculados eliminados" }
        }
      }
    },
    "/restaurants/{id}/approve": {
      "patch": {
        "summary": "Aprobar restaurante (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Restaurante aprobado" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/restaurants/{id}/reject": {
      "patch": {
        "summary": "Rechazar restaurante (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Restaurante rechazado" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/restaurants/{id}/dishes": {
      "post": {
        "summary": "Agregar un plato a un restaurante (dueño o admin)",
        "tags": ["Restaurantes"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "descripcion", "precio"],
                "properties": {
                  "nombre": { "type": "string" },
                  "descripcion": { "type": "string" },
                  "precio": { "type": "number" },
                  "imagenUrl": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Plato creado" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/restaurants/dishes/{dishId}/approve": {
      "patch": {
        "summary": "Aprobar plato (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "dishId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Plato aprobado con éxito" }
        }
      }
    },
    "/restaurants/dishes/{dishId}/reject": {
      "patch": {
        "summary": "Rechazar plato (Solo Admin)",
        "tags": ["Restaurantes (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "dishId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Plato rechazado" }
        }
      }
    },
    "/reviews": {
      "post": {
        "summary": "Crear reseña con transacción ACID y recálculo de ranking",
        "tags": ["Reseñas"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["restauranteId", "calificacion", "comentario"],
                "properties": {
                  "restauranteId": { "type": "string", "example": "64f1a2b3c4d5e6f7a8b9c0d1" },
                  "calificacion": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
                  "comentario": { "type": "string", "example": "Excelente servicio y calidad de comida" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Reseña guardada y ranking actualizado" },
          "400": { "description": "Error en datos o restaurante no aprobado" }
        }
      }
    },
    "/reviews/restaurant/{id}": {
      "get": {
        "summary": "Listar las reseñas de un restaurante",
        "tags": ["Reseñas"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Reseñas del restaurante" }
        }
      }
    },
    "/reviews/{id}/vote": {
      "post": {
        "summary": "Dar like o dislike a una reseña (transacción atómica)",
        "tags": ["Reseñas"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo"],
                "properties": {
                  "tipo": { "type": "string", "enum": ["like", "dislike"], "example": "like" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Voto registrado exitosamente" },
          "403": { "description": "No se permite votar la propia reseña" }
        }
      }
    },
    "/reviews/{id}": {
      "delete": {
        "summary": "Eliminar reseña (autor o admin) con recálculo transaccional del ranking",
        "tags": ["Reseñas"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Reseña eliminada y ranking actualizado" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/reviews/admin/all": {
      "get": {
        "summary": "Listar todas las reseñas para moderación (Solo Admin)",
        "tags": ["Reseñas (Admin)"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Todas las reseñas con autor y restaurante" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  }
}